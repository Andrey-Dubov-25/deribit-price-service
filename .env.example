APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/deribit

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

